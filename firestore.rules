
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Blueprints ---
    
    function isValidBook(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 2000 &&
             data.userId == request.auth.uid &&
             (data.get('author', '') is string) &&
             (data.get('progress', 0) is number) &&
             (data.get('readingTime', 0) is number);
    }

    function isValidQuote(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.text is string && data.text.size() <= 15000 &&
             data.bookId is string && data.bookId.size() <= 128 &&
             data.userId == request.auth.uid;
    }

    function isValidNote(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.text is string && data.text.size() <= 15000 &&
             data.note is string && data.note.size() <= 15000 &&
             data.bookId is string && data.bookId.size() <= 128 &&
             data.userId == request.auth.uid;
    }

    function isValidUser(data) {
        return data.uid == request.auth.uid &&
               data.email is string &&
               (data.get('streak', 0) is number);
    }

    // --- Collection Rules ---

    match /users/{userId} {
      // User can manage their own profile
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming());

      match /books/{bookId} {
        allow read: if isOwner(userId);
        
        allow create: if isOwner(userId) && 
                        isValidId(bookId) && 
                        isValidBook(incoming()) &&
                        incoming().keys().hasAll(['id', 'title', 'userId']);

        allow update: if isOwner(userId) && 
                        isValidBook(incoming()) &&
                        incoming().userId == existing().userId &&
                        incoming().id == existing().id;
                        
        allow delete: if isOwner(userId);
      }

      match /quotes/{quoteId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && 
                        isValidId(quoteId) && 
                        isValidQuote(incoming()) &&
                        incoming().keys().hasAll(['id', 'text', 'bookId', 'userId']);
        
        allow update: if isOwner(userId) && 
                        isValidQuote(incoming()) &&
                        incoming().userId == existing().userId &&
                        incoming().id == existing().id;
                        
        allow delete: if isOwner(userId);
      }

      match /notes/{noteId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && 
                        isValidId(noteId) && 
                        isValidNote(incoming()) &&
                        incoming().keys().hasAll(['id', 'text', 'note', 'bookId', 'userId']);
        
        allow update: if isOwner(userId) && 
                        isValidNote(incoming()) &&
                        incoming().userId == existing().userId &&
                        incoming().id == existing().id;
                        
        allow delete: if isOwner(userId);
      }
    }
  }
}
