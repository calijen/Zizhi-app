
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidBook(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 2000 &&
             data.userId == request.auth.uid;
    }

    function isValidQuote(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.text is string && data.text.size() <= 10000 &&
             data.bookId is string &&
             data.userId == request.auth.uid;
    }

    function isValidNote(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.text is string && data.text.size() <= 10000 &&
             data.note is string && data.note.size() <= 10000 &&
             data.bookId is string &&
             data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);

      match /books/{bookId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidBook(request.resource.data) && isValidId(bookId);
        allow update: if isOwner(userId) && isValidBook(request.resource.data) &&
                        request.resource.data.userId == resource.data.userId;
        allow delete: if isOwner(userId);
      }

      match /quotes/{quoteId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidQuote(request.resource.data) && isValidId(quoteId);
        allow update: if isOwner(userId) && isValidQuote(request.resource.data) &&
                        request.resource.data.userId == resource.data.userId;
        allow delete: if isOwner(userId);
      }

      match /notes/{noteId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidNote(request.resource.data) && isValidId(noteId);
        allow update: if isOwner(userId) && isValidNote(request.resource.data) &&
                        request.resource.data.userId == resource.data.userId;
        allow delete: if isOwner(userId);
      }
    }
  }
}
