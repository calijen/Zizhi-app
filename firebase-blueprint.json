{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and settings",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "number" },
        "lastLogin": { "type": "number" }
      },
      "required": ["uid", "email"]
    },
    "Book": {
      "title": "Book",
      "description": "Book metadata and content",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "author": { "type": "string" },
        "coverImageUrl": { "type": "string" },
        "progress": { "type": "number" },
        "lastScrollTop": { "type": "number" },
        "lastOpened": { "type": "number" },
        "readingTime": { "type": "number" },
        "genre": { "type": "string" },
        "hasSummary": { "type": "boolean" },
        "hasAudio": { "type": "boolean" },
        "isPdf": { "type": "boolean" },
        "chapters": { "type": "array" },
        "toc": { "type": "array" },
        "summaryScript": { "type": "string" },
        "audioSummaryUrl": { "type": "string" }
      },
      "required": ["id", "title", "author"]
    },
    "Quote": {
      "title": "Quote",
      "description": "User highlight/quote",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" },
        "bookTitle": { "type": "string" },
        "author": { "type": "string" },
        "bookId": { "type": "string" },
        "location": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "text", "bookId"]
    },
    "Note": {
      "title": "Note",
      "description": "User note on a text",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" },
        "note": { "type": "string" },
        "bookTitle": { "type": "string" },
        "author": { "type": "string" },
        "bookId": { "type": "string" },
        "location": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "text", "note", "bookId"]
    },
    "Activity": {
      "title": "Activity",
      "description": "Daily reading time logs",
      "type": "object",
      "properties": {
        "date": { "type": "string" },
        "seconds": { "type": "number" }
      },
      "required": ["date", "seconds"]
    },
    "ChatSession": {
      "title": "ChatSession",
      "description": "AI chat history with Phoebe",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "messages": { "type": "array" },
        "createdAt": { "type": "number" },
        "lastUpdatedAt": { "type": "number" }
      },
      "required": ["id", "title", "messages"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "users/{userId}/books/{bookId}": {
      "schema": "Book",
      "description": "User document library"
    },
    "users/{userId}/quotes/{quoteId}": {
      "schema": "Quote",
      "description": "User highlights"
    },
    "users/{userId}/notes/{noteId}": {
      "schema": "Note",
      "description": "User notes"
    },
    "users/{userId}/activity/{date}": {
      "schema": "Activity",
      "description": "User reading stats"
    },
    "users/{userId}/chats/{chatId}": {
      "schema": "ChatSession",
      "description": "User chat sessions"
    }
  }
}
